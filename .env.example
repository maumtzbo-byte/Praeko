# Supabase — Settings > API in your project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic) — business/strategy/script/quality-review agents.
ANTHROPIC_API_KEY=

# fal.ai — video/image generation (Kling 3.0 Pro, Seedance 2.0).
FAL_API_KEY=

# Whisper API — transcription for burned-in subtitles (Pro/Max).
OPENAI_API_KEY=

# Stripe — subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Meta Graph API (Instagram/Facebook) — OAuth app credentials, Fase 2.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business Configuration ID (Meta dashboard: Facebook
# Login > Configuraciones) — must grant pages_show_list,
# pages_read_engagement, pages_manage_posts, business_management,
# instagram_basic, instagram_content_publish.
META_CONFIG_ID=
# Any random string you choose — paste the same value into Meta's dashboard
# (Webhooks product > Verify token) when subscribing to comments/messages
# for Agente de Respuestas. Also needs pages_manage_metadata,
# pages_messaging, instagram_manage_comments, instagram_manage_messages
# added via Casos de uso before those webhook fields are selectable.
META_WEBHOOK_VERIFY_TOKEN=

# TikTok API for Business — OAuth app credentials, Fase 2 (opcional).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Shopify Admin API — conexión con tu tienda (base para los agentes de
# producto/inventario/marketing). Desde enero de 2026 Shopify ya no
# muestra un token estático para copiar: las custom apps nuevas se crean
# en el Dev Dashboard y usan el flujo OAuth "client credentials grant"
# (el código intercambia Client ID + Client Secret por un token que dura
# ~24h y se renueva solo — ver src/lib/providers/shopify/client.ts).
#
# Pasos: admin de Shopify > Configuración > Apps y canales de venta >
# Desarrollar apps > "Compilar apps con Dev Dashboard" (o directo en
# dev.shopify.com) > Crear app > en Configuración agrega los scopes
# read_products y write_products > instala la app en tu tienda > pestaña
# Configuración/Settings del Dev Dashboard: copia el Client ID y el
# Client secret.
# SHOPIFY_STORE_DOMAIN es el dominio *.myshopify.com (no el dominio
# personalizado si tienes uno conectado).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Google Business Profile — OAuth app credentials from a Google Cloud
# project (APIs & Services > Credentials > OAuth client ID, type "Web
# application"). Add "<your-domain>/social/google_business/callback" as an
# authorized redirect URI. Scope used: business.manage.
#
# IMPORTANT: minting these two values is NOT enough to make real API calls
# work. Google gates the Business Profile APIs behind a separate manual
# access request (a business-justification form, reviewed in ~2+ weeks,
# can be rejected) — search "Google Business Profile API access request"
# for the current form. Without approval, every call from
# src/lib/social/google-business.ts 403s even with valid OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
