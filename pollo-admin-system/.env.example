# Copia este archivo a .env y completa con los valores de tu proyecto Supabase
# (Configuración → API en el dashboard de Supabase).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# Solo para scripts/seed-demo-data.ts (nunca se expone al navegador)
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
